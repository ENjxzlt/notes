# Gemeinsames Geheimnis der Geräte (mindestens 24 Zeichen): openssl rand -hex 24
NOTES_TOKEN=
TZ=Europe/Berlin
# Zugang für Claude (MCP), eigenes Geheimnis, MUSS sich von NOTES_TOKEN unterscheiden. Leer lassen = MCP aus.
# openssl rand -hex 24
MCP_TOKEN=
# Öffentliche HTTPS-Adresse des Servers (z. B. über den Cloudflare-Tunnel). Schaltet den OAuth-Connector für claude.ai frei
# und ist nötig, damit Claude den Server als „Connector“ hinzufügen kann. Leer = nur Token-Zugang für Claude Code.
PUBLIC_URL=
